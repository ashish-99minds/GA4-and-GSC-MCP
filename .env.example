# Paste the full JSON contents of your Google service account key here, as one line.
# This service account needs to be granted access inside GA4 and Search Console
# directly (see README.md), it does not need any Google Cloud IAM roles beyond
# having the three APIs enabled on the project.
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}

# The password checked on the login screen when Claude connects for the first
# time (or after a token expires and no valid refresh token is available).
# Pick something long and random, this is the only thing standing between the
# public internet and your GA4/GSC data.
MCP_LOGIN_PASSWORD=replace-with-a-long-random-password

# Secret used to sign and verify access tokens (HMAC). Generate one with:
# openssl rand -hex 32
MCP_JWT_SECRET=replace-with-a-long-random-string
